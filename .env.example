# ── Good Food, self-hosted ──────────────────────────────────────────────
# Copy to .env next to docker-compose.yml and fill in.

# DATABASE ─────────────────────────────────────────────────────────────

# Password for the bundled Postgres. Letters and digits only.
# Set it before the first start: the database keeps the one it was created with.
POSTGRES_PASSWORD=

# Only when running without Docker — docker-compose.yml builds its own.
# DATABASE_URL=postgres://goodfood:PASSWORD@localhost:5432/goodfood

# SESSIONS ─────────────────────────────────────────────────────────────

# Signs the session cookies and the picture links:  openssl rand -hex 32
# Changing it logs everyone out.
JWT_SECRET=

# TELEGRAM BOT ─────────────────────────────────────────────────────────

# @BotFather → /newbot (or /token for an existing bot)
TELEGRAM_BOT_TOKEN=

# Chat id of the operators' group that gets "new user" notifications.
# Groups are NEGATIVE (e.g. -1001234567890). Add the bot to the group and
# send /id there.
TELEGRAM_ADMIN_GROUP_ID=

# Chat id of the kitchen group that receives prep lists (negative, same /id trick).
TELEGRAM_KITCHEN_GROUP_ID=

# Any random string. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header; the webhook rejects mismatches.
TELEGRAM_WEBHOOK_SECRET=

# The public https address is not set here: admin panel → Настройки →
# Адрес сервера. Saving it there points the bot's webhook at it.

# FRONTPAD ─────────────────────────────────────────────────────────────

# FrontPad → Настройки → API → секретный ключ. Server-only.
# Leave empty and the FrontPad integration stays off.
FRONTPAD_APIKEY=

# TUNNEL (optional) ────────────────────────────────────────────────────

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token.
# Start it with:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Port on this computer: http://localhost:3000
# APP_PORT=3000

# ONE-TIME IMPORT FROM SUPABASE ────────────────────────────────────────

# Read only by scripts/import-supabase.js. Delete both after the import.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
