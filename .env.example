# ── Render → Environment ────────────────────────────────────────────────

# REQUIRED ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase → Project Settings → API → service_role secret.
# Server-only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Signs the session cookies:  openssl rand -hex 32
# Changing it logs everyone out.
JWT_SECRET=<64 random hex chars>

# TELEGRAM BOT ─────────────────────────────────────────────────────────

# @BotFather → /newbot (or /token for an existing bot)
TELEGRAM_BOT_TOKEN=1234567890:AAE...

# Chat id of the operators' group that gets "new user" notifications.
# Groups are NEGATIVE (e.g. -1001234567890). Add the bot to the group, post
# a message there, then read the id from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_GROUP_ID=-1001234567890

# Any random string. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header; the webhook rejects mismatches.
# Leave empty to skip the check (not recommended in production).
TELEGRAM_WEBHOOK_SECRET=<32 random hex chars>

# Your Render URL, used when registering the webhook (see README).
PUBLIC_URL=https://your-service.onrender.com

# OPTIONAL ─────────────────────────────────────────────────────────────

# Render sets PORT itself — only set it locally.
# PORT=3000

# Render sets NODE_ENV=production on its own; setting it explicitly is fine
# and is what makes session cookies Secure.
NODE_ENV=production

# Not used (the server only ever talks to Supabase with service_role).
SUPABASE_ANON_KEY=

# Chat id of the kitchen group that receives prep lists (negative).
# Same discovery trick as the admin group: add the bot, send /id.
TELEGRAM_KITCHEN_GROUP_ID=
