# ── Good Food ────────────────────────────────────────────────────────────
# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Адрес сервера (https) задаётся не здесь, а в админке:
# Настройки → Адрес сервера.

# Подпись сессий и ссылок на картинки:  openssl rand -hex 32
# Если его сменить, всех разлогинит.
JWT_SECRET=

# Первый админ. При запуске, если пользователя с этим Chat ID ещё нет,
# сервер создаёт его админом компании с паролем ADMIN_PASSWORD
# (компания создаётся, если такой нет). Вход в /admin: Логин = Chat ID, Пароль = ADMIN_PASSWORD.
# Chat ID — ваш личный: написать боту /id. Пароль: латиница, цифры, дефис, до 32 символов.
ADMIN_CHAT_ID=
ADMIN_PASSWORD=

# Бот: @BotFather → /newbot (или /token)
TELEGRAM_BOT_TOKEN=

# Любая случайная строка: так вебхук отличает запросы Telegram от чужих.
TELEGRAM_WEBHOOK_SECRET=

# Chat ID групп (отрицательные, например -1001234567890).
# Добавьте бота в группу и отправьте там /id.
TELEGRAM_ADMIN_GROUP_ID=
TELEGRAM_KITCHEN_GROUP_ID=

# FrontPad → Настройки → API → секретный ключ. Пусто — интеграция выключена.
FRONTPAD_APIKEY=

# ── Загрузка из Supabase при первом запуске ─────────────────────────────
# Supabase → Project Settings → API: Project URL и service_role key.
# Если база пустая, сервер при старте сам загрузит отсюда все данные и картинки.
# После переноса обе строки можно удалить.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Необязательно ────────────────────────────────────────────────────────
# Пароль встроенного Postgres (по умолчанию goodfood; наружу база не открыта).
# Задавать до первого запуска: база запоминает пароль, с которым создана.
# POSTGRES_PASSWORD=

# Порт на этом компьютере (по умолчанию 3000).
# APP_PORT=3000

# Токен Cloudflare Tunnel, см. README → «Доступ из интернета».
# CLOUDFLARE_TUNNEL_TOKEN=
